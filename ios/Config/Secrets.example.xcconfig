// Copy to Secrets.xcconfig (same folder) and fill in. Never commit Secrets.xcconfig.

// Xcode → Settings → Accounts → your team → the 10-character Team ID.
DEVELOPMENT_TEAM = ABCDE12345

// Reverse-DNS you own, e.g. com.yourname. The app ID becomes <prefix>.asthmalog.
BUNDLE_ID_PREFIX = com.yourname

// Free keys. Missing keys are fine: that source is skipped.
// https://explore.openaq.org/register
OPENAQ_API_KEY =
// https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY =
